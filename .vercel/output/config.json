{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/api/stripe/connect/?(?:/__data.json)?$",
			"dest": "/api/stripe/connect"
		},
		{
			"src": "^/api/stripe/return/?(?:/__data.json)?$",
			"dest": "/api/stripe/return"
		},
		{
			"src": "^/api/stripe/webhook/?(?:/__data.json)?$",
			"dest": "/api/stripe/webhook"
		},
		{
			"src": "^/auth/callback/?(?:/__data.json)?$",
			"dest": "/auth/callback"
		},
		{
			"src": "^/auth/login/?(?:/__data.json)?$",
			"dest": "/auth/login"
		},
		{
			"src": "^/auth/logout/?(?:/__data.json)?$",
			"dest": "/auth/logout"
		},
		{
			"src": "^/auth/onboarding/?(?:/__data.json)?$",
			"dest": "/auth/onboarding"
		},
		{
			"src": "^/auth/signup/?(?:/__data.json)?$",
			"dest": "/auth/signup"
		},
		{
			"src": "^/browse/?(?:/__data.json)?$",
			"dest": "/browse"
		},
		{
			"src": "^/listings/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/listings/[id]"
		},
		{
			"src": "^/listings/([^/]+?)/book/?(?:/__data.json)?$",
			"dest": "/listings/[id]/book"
		},
		{
			"src": "^/listings/([^/]+?)/book/confirmation/?(?:/__data.json)?$",
			"dest": "/listings/[id]/book/confirmation"
		},
		{
			"src": "^/messages/?(?:/__data.json)?$",
			"dest": "/messages"
		},
		{
			"src": "^/post/?(?:/__data.json)?$",
			"dest": "/post"
		},
		{
			"src": "^/profile/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/profile/[username]"
		},
		{
			"src": "^/reviews/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/reviews/[transaction_id]"
		},
		{
			"src": "^/settings/?(?:/__data.json)?$",
			"dest": "/settings"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}